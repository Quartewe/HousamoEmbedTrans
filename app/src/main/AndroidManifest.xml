<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="jp.co.lifewonders.housamo" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HousamoEmbedTrans">

        <!-- 设置入口 Activity -->
        <activity
            android:name=".ui.CharacterDictionaryActivity"
            android:exported="false"
            android:label="@string/chardict_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.GameTermsActivity"
            android:exported="false"
            android:label="@string/gameterms_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SceneFilesActivity"
            android:exported="false"
            android:label="@string/scene_files_title" />

        <activity
            android:name=".ui.SceneConflictsActivity"
            android:exported="false"
            android:label="@string/scene_conflicts_title" />

        <activity
            android:name=".ui.RejectedApiResultsActivity"
            android:exported="false"
            android:label="@string/rejected_api_results_title" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".bridge.UserConfigProvider"
            android:authorities="com.quarty.housamoembedtrans.userfiles"
            android:exported="true"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".runtime.TranslationControlReceiver"
            android:exported="false" />

        <!-- LSPosed 模块标记 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- 模块作用域：限定目标游戏 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
