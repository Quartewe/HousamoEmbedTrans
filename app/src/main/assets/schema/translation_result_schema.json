{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "A summary of the target language for the current complete scene."
    },
    "context_summary": {
      "type": "string",
      "minLength": 1,
      "description": "Only present when the original request requires request_context_summary."
    },
    "translations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "seq",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "target_lang": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "summary",
    "translations",
    "provider",
    "model",
    "target_lang"
  ],
  "additionalProperties": false
}