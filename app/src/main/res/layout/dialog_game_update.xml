<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_update_scroll"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/game_update_heading" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="24sp"
            android:textColor="@color/het_on_surface" android:layout_marginTop="12dp" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/game_update_version_card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/het_surface_container">
            <TextView android:id="@+id/game_update_versions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="16dp" android:textSize="20sp"
                android:gravity="center" android:textColor="@color/het_primary" />
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:id="@+id/game_update_steps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
            <TextView android:id="@+id/game_update_step_download" style="@style/Widget.HET.GameUpdate.Step" />
            <TextView android:id="@+id/game_update_step_obb" style="@style/Widget.HET.GameUpdate.Step" />
            <TextView android:id="@+id/game_update_step_apk" style="@style/Widget.HET.GameUpdate.Step" />
            <TextView android:id="@+id/game_update_step_runtime" style="@style/Widget.HET.GameUpdate.Step" />
        </LinearLayout>
        <ProgressBar android:id="@+id/game_update_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:max="100" />
        <TextView android:id="@+id/game_update_progress_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="end" android:textSize="12sp"
            android:textColor="@color/het_on_surface_muted" />
        <TextView android:id="@+id/game_update_detail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="14sp"
            android:lineSpacingMultiplier="1.2" android:textColor="@color/het_on_surface_muted" />
    </LinearLayout>
</ScrollView>
