<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_scene_conflict"
    style="@style/Widget.HET.StaticManagement.ConflictCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_scene_conflict_name"
            style="@style/TextAppearance.HET.StaticManagement.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_scene_conflict_changes"
            style="@style/TextAppearance.HET.StaticManagement.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_scene_conflict_game_summary"
            style="@style/TextAppearance.HET.StaticManagement.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_static_management_status"
            android:padding="9dp" />

        <TextView
            android:id="@+id/tv_scene_conflict_het_summary"
            style="@style/TextAppearance.HET.StaticManagement.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_static_management_status"
            android:padding="9dp" />

        <TextView
            android:id="@+id/tv_scene_conflict_error"
            style="@style/TextAppearance.HET.StaticManagement.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/scene_conflict_unreadable"
            android:textColor="@color/het_error"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scene_conflict_toggle"
            style="@style/Widget.HET.StaticManagement.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/scene_conflict_expand" />

        <TextView
            android:id="@+id/tv_scene_conflict_details"
            style="@style/TextAppearance.HET.StaticManagement.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_static_management_status"
            android:padding="9dp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_scene_conflict_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scene_conflict_choose_game"
                style="@style/Widget.HET.StaticManagement.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="@string/scene_conflict_choose_game" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scene_conflict_choose_het"
                style="@style/Widget.HET.StaticManagement.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:text="@string/scene_conflict_choose_het" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
