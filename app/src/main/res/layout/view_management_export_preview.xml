<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_management_export_preview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/het_surface"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:importantForAccessibility="yes"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_management_export_preview"
        style="@style/Widget.HET.ManagementImport.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/back_action"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/management_transfer_export_preview_toolbar_title" />

    <LinearLayout
        android:id="@+id/container_management_export_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_management_export_eyebrow"
            style="@style/TextAppearance.HET.ManagementImport.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/management_transfer_export_eyebrow" />

        <TextView
            android:id="@+id/tv_management_export_heading"
            style="@style/TextAppearance.HET.ManagementImport.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/management_transfer_export_preview_title" />

        <TextView
            android:id="@+id/tv_management_export_description"
            style="@style/TextAppearance.HET.ManagementImport.Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/management_transfer_export_description" />

        <TextView
            android:id="@+id/tv_management_export_summary"
            style="@style/TextAppearance.HET.ManagementImport.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp" />
    </LinearLayout>

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_management_export_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/container_management_export_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp" />
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <LinearLayout
        android:id="@+id/page_actions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/het_bottom_bar_height"
        android:background="@drawable/bg_primary_navigation"
        android:baselineAligned="false"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:id="@+id/container_management_export_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_management_export_cancel"
            style="@style/Widget.HET.ManagementImport.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/management_transfer_export_preview_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_management_export_continue"
            style="@style/Widget.HET.ManagementImport.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/management_transfer_export_preview_continue" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
