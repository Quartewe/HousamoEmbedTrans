<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_scene_sync_conflict"
    style="@style/Widget.HET.StaticManagement.ConflictCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header_scene_sync_conflict"
            style="@style/Widget.HET.SectionHeader"
            android:minHeight="52dp">

            <TextView
                android:id="@+id/tv_scene_sync_conflict_name"
                style="@style/TextAppearance.HET.StaticManagement.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_scene_sync_conflict_arrow"
                style="@style/Widget.HET.SectionArrow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⌄" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/body_scene_sync_conflict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_scene_sync_conflict_changes"
                style="@style/TextAppearance.HET.StaticManagement.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/container_scene_sync_conflict_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_static_management_status"
                android:orientation="vertical"
                android:padding="9dp">

                <TextView
                    android:id="@+id/tv_scene_sync_conflict_game_summary"
                    style="@style/TextAppearance.HET.StaticManagement.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scene_sync_conflict_choose_game"
                    style="@style/Widget.HET.StaticManagement.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/scene_conflict_choose_game" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_scene_sync_conflict_het"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_static_management_status"
                android:orientation="vertical"
                android:padding="9dp">

                <TextView
                    android:id="@+id/tv_scene_sync_conflict_het_summary"
                    style="@style/TextAppearance.HET.StaticManagement.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scene_sync_conflict_choose_het"
                    style="@style/Widget.HET.StaticManagement.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/scene_conflict_choose_het" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_scene_sync_conflict_error"
                style="@style/TextAppearance.HET.StaticManagement.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/scene_conflict_unreadable"
                android:textColor="@color/het_error"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_scene_sync_conflict_details"
                style="@style/TextAppearance.HET.StaticManagement.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_static_management_status"
                android:padding="9dp"
                android:textIsSelectable="true"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
