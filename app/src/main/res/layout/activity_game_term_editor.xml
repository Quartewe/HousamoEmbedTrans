<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_game_term_editor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/het_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_game_term_editor"
        style="@style/Widget.HET.StaticDetail.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/back_action"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_game_term_editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/container_game_term_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="15dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tv_game_term_editor_status"
                style="@style/TextAppearance.HET.StaticDetail.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_config_status"
                android:padding="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_game_term_editor_heading"
                style="@style/TextAppearance.HET.StaticDetail.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="@string/edit_game_term"
                android:textSize="19sp" />

            <TextView
                style="@style/TextAppearance.HET.StaticDictionary.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="9dp"
                android:text="@string/game_term_editor_draft_hint" />

            <LinearLayout
                android:id="@+id/game_term_editor_key_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.HET.StaticDictionary.Helper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dictionary_editor_label_term_key"
                    android:textColor="@color/het_on_surface_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_game_term_editor_key"
                    style="@style/Widget.HET.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint=""
                    android:padding="0dp"
                    app:boxCollapsedPaddingTop="0dp"
                    app:expandedHintEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_game_term_editor_key"
                        style="@style/Widget.HET.StaticDictionary.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:minHeight="40dp"
                        android:paddingStart="10dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="9dp"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/game_term_editor_name_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.HET.StaticDictionary.Helper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dictionary_editor_label_term_name"
                    android:textColor="@color/het_on_surface_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_game_term_editor_name"
                    style="@style/Widget.HET.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint=""
                    android:padding="0dp"
                    app:boxCollapsedPaddingTop="0dp"
                    app:expandedHintEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_game_term_editor_name"
                        style="@style/Widget.HET.StaticDictionary.FieldInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:minHeight="40dp"
                        android:paddingStart="10dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="9dp"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_game_term_editor_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_move_game_term_pending_editor_hint"
                style="@style/TextAppearance.HET.StaticDictionary.Helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dictionary_editor_move_pending_hint"
                android:visibility="gone" />
        </LinearLayout>
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <LinearLayout
        android:id="@+id/page_actions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/het_bottom_bar_height"
        android:background="@drawable/bg_primary_navigation"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:gravity="end"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/container_game_term_editor_actions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_discard_game_term_editor"
                    style="@style/Widget.HET.StaticDetail.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:minHeight="34dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:text="@string/discard_changes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_game_term_editor"
                    style="@style/Widget.HET.StaticDetail.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="34dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:text="@string/save_game_term" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_move_game_term_pending_editor"
                    style="@style/Widget.HET.StaticDetail.Button.Danger"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="34dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:text="@string/dictionary_editor_move_pending"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
