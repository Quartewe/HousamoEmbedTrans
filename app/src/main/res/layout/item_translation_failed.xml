<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_translation_failed_item"
    style="@style/Widget.HET.StaticTask.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:checkable="true"
    app:checkedIcon="@null"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_translation_failed_number"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_queue_number"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.HET.StaticTask.Status"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_translation_failed_scene"
                    style="@style/TextAppearance.HET.StaticTask.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/tv_translation_failed_language"
                    style="@style/TextAppearance.HET.StaticTask.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_translation_failed_updated_at"
                    style="@style/TextAppearance.HET.StaticTask.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_translation_failed_status"
            style="@style/TextAppearance.HET.StaticTask.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_static_task_status"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tv_translation_failed_summary"
            style="@style/TextAppearance.HET.StaticTask.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_translation_failed_primary"
                style="@style/Widget.HET.StaticTask.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/translation_job_details" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
