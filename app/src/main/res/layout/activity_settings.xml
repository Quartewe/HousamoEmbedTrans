<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Housamo 翻译设置"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- API 地址 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API 地址"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />
    <EditText
        android:id="@+id/et_api_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://api.example.com/translate"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <!-- API Key -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API Key"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />
    <EditText
        android:id="@+id/et_api_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入你的 API Key"
        android:inputType="textPassword"
        android:layout_marginBottom="12dp" />

    <!-- 启用翻译 -->
    <CheckBox
        android:id="@+id/cb_enable_translation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="启用实时翻译"
        android:layout_marginBottom="12dp" />

    <!-- 启用字典 -->
    <CheckBox
        android:id="@+id/cb_enable_dict"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="启用术语字典替换"
        android:layout_marginBottom="24dp" />

    <!-- 保存按钮 -->
    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存设置" />

</LinearLayout>
