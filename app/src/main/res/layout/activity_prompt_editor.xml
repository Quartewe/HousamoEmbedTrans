<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_prompt_editor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_prompt_editor"
        style="@style/Widget.HET.SettingsRebuild.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/back_action"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings_prompt_title" />

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_prompt_editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="15dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tv_prompt_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_prompt_eyebrow"
                android:textColor="@color/het_primary_strong"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tv_prompt_kind_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/het_on_surface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_prompt_kind_helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/het_on_surface_muted"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.5"
                android:includeFontPadding="false" />

            <LinearLayout
                android:id="@+id/prompt_kind_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_prompt_translation"
                    style="@style/Widget.HET.Prompt.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/settings_prompt_translation_tab" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_prompt_summary"
                    style="@style/Widget.HET.Prompt.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_prompt_summary_tab" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_prompt_role"
                    android:textColor="@color/het_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.HET.Prompt.TextInputLayout"
                    android:layout_marginTop="4dp"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/het_surface_container"
                    app:boxStrokeColor="@color/het_settings_rebuild_text_input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:expandedHintEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_prompt_role"
                        style="@style/Widget.HET.Prompt.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="5" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_prompt_style"
                    android:textColor="@color/het_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.HET.Prompt.TextInputLayout"
                    android:layout_marginTop="4dp"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/het_surface_container"
                    app:boxStrokeColor="@color/het_settings_rebuild_text_input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:expandedHintEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_prompt_style"
                        style="@style/Widget.HET.Prompt.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="7" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_prompt_context"
                    android:textColor="@color/het_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.HET.Prompt.TextInputLayout"
                    android:layout_marginTop="4dp"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/het_surface_container"
                    app:boxStrokeColor="@color/het_settings_rebuild_text_input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:expandedHintEnabled="false"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_prompt_context"
                        style="@style/Widget.HET.Prompt.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="5" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HET.Prompt.ReadonlyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_prompt_readonly_outline"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_prompt_readonly_title"
                        android:textColor="@color/het_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tv_prompt_readonly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/het_on_surface_muted"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.45"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_prompt_memory_hint"
                android:textColor="@color/het_on_surface_muted"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.45"
                android:includeFontPadding="false" />
        </LinearLayout>
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <LinearLayout
        android:id="@+id/prompt_page_actions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/het_bottom_bar_height"
        android:background="@drawable/bg_primary_navigation"
        android:gravity="center_vertical|end"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prompt_save"
            style="@style/Widget.HET.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:textSize="13sp"
            android:text="@string/settings_prompt_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prompt_discard"
            style="@style/Widget.HET.Button.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:text="@string/settings_prompt_discard" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prompt_reset"
            style="@style/Widget.HET.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:text="@string/settings_prompt_reset" />
    </LinearLayout>
</LinearLayout>
