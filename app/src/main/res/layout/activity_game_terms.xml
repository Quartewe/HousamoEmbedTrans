<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_game_terms"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/het_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_game_terms"
        style="@style/Widget.HET.StaticDetail.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/back_action"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/gameterms_title" />

    <TextView
        style="@style/TextAppearance.HET.StaticDetail.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="14dp"
        android:text="@string/gameterms_editor_hint"
        />

    <TextView
        android:id="@+id/tv_gameterms_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_config_status"
        android:padding="10dp"
        android:textAppearance="@style/TextAppearance.HET.StaticDetail.Status" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.HET.TextInputLayout"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:hint="@string/search_game_terms"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_gameterms_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_game_terms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="none"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tv_game_terms_empty"
            style="@style/TextAppearance.HET.StaticDetail.Empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/no_game_terms_found"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/page_actions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/het_bottom_bar_height"
        android:background="@drawable/bg_primary_navigation"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:gravity="end"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restore_gameterms"
                    style="@style/Widget.HET.StaticDetail.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/reset_defaults" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_gameterms"
                    style="@style/Widget.HET.StaticDetail.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/management_transfer_import_terms" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_game_term"
                    style="@style/Widget.HET.StaticDetail.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/add_game_term" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_gameterms"
                    style="@style/Widget.HET.StaticDetail.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/save_settings" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
