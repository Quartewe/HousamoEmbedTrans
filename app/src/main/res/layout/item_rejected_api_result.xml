<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_rejected_api_result"
    style="@style/Widget.HET.StaticTask.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rejected_api_result_kind"
                    style="@style/TextAppearance.HET.StaticTask.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    />

                <TextView
                    android:id="@+id/tv_rejected_api_result_request"
                    style="@style/TextAppearance.HET.StaticTask.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_rejected_api_result_created"
                style="@style/TextAppearance.HET.StaticTask.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_rejected_api_result"
                style="@style/Widget.HET.StaticTask.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/rejected_api_result_delete"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_rejected_api_result_reason_label"
            style="@style/TextAppearance.HET.StaticTask.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/task_waiting_reason" />

        <TextView
            android:id="@+id/tv_rejected_api_result_reason"
            style="@style/TextAppearance.HET.StaticTask.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_rejected_api_result"
            style="@style/Widget.HET.StaticTask.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="7dp"
            android:text="@string/rejected_api_result_view_payload"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
