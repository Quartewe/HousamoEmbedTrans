<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_management_import"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/het_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_management_import"
        style="@style/Widget.HET.ManagementImport.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/back_action"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/management_import_title" />

    <LinearLayout
        android:id="@+id/container_management_import_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/tv_management_import_eyebrow"
            style="@style/TextAppearance.HET.ManagementImport.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/management_import_eyebrow" />

        <TextView
            android:id="@+id/tv_management_import_heading"
            style="@style/TextAppearance.HET.ManagementImport.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_management_import_description"
            style="@style/TextAppearance.HET.ManagementImport.Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp" />
    </LinearLayout>

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_management_import_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/container_management_import_source_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_management_import_surface"
            android:clipToPadding="false"
            android:orientation="vertical">

        <TextView
            android:id="@+id/tv_management_import_status"
            style="@style/TextAppearance.HET.ManagementImport.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp" />

        <LinearLayout
            android:id="@+id/container_management_import_file_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_management_import_add"
            style="@style/Widget.HET.ManagementImport.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:contentDescription="@string/management_import_add_description"
            android:text=""
            app:icon="@drawable/ic_management_import_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_management_import_remove_mode"
            style="@style/Widget.HET.ManagementImport.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/management_import_remove_mode_description"
            android:text=""
            app:icon="@drawable/ic_management_import_remove"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_management_import_remove_cancel"
                style="@style/Widget.HET.ManagementImport.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/management_import_remove_cancel_description"
                android:text="@string/cancel_action"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_management_import_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />
        </LinearLayout>
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_management_import_preflight"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/container_management_import_preflight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp" />
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_management_import_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/container_management_import_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_management_import_preview"
                style="@style/TextAppearance.HET.ManagementImport.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_management_import_summary"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:textIsSelectable="true" />

            <LinearLayout
                android:id="@+id/container_management_import_preview_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <LinearLayout
        android:id="@+id/page_actions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/het_bottom_bar_height"
        android:background="@drawable/bg_primary_navigation"
        android:baselineAligned="false"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <FrameLayout
            android:id="@+id/container_management_import_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_management_import_confirm_files"
                style="@style/Widget.HET.ManagementImport.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/management_import_confirm_files" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/container_management_import_preview_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_management_import_generate_preview"
            style="@style/Widget.HET.ManagementImport.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/management_import_generate_preview" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_management_import_apply"
            style="@style/Widget.HET.ManagementImport.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:enabled="false"
            android:text="@string/management_import_apply" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
