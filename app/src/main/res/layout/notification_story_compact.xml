<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/story_status"
        style="@android:style/TextAppearance.Material.Notification.Title"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginEnd="8dp" android:maxLines="2" android:ellipsize="end"
        android:textSize="12sp" />
    <TextView android:id="@+id/story_back"
        android:layout_width="112dp" android:layout_height="40dp"
        android:background="@drawable/notification_choice_button" android:gravity="center"
        android:text="@string/notification_choice_back_short" android:textColor="@color/notification_choice_text"
        android:textSize="13sp" android:maxLines="1"
        android:contentDescription="@string/notification_action_choice_back" />
    <ImageView android:id="@+id/story_capture"
        android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
        android:src="@drawable/ic_task_pause"
        android:contentDescription="@string/notification_action_pause_capture" />
</LinearLayout>
