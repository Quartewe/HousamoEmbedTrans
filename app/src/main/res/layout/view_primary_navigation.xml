<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/primary_navigation"
    android:layout_width="match_parent"
    android:layout_height="@dimen/het_bottom_bar_height"
    android:background="@drawable/bg_primary_navigation"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_primary_navigation_item"
        android:clickable="true"
        android:contentDescription="@string/primary_nav_home"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:id="@+id/nav_home_icon"
            android:layout_width="54dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_primary_navigation_icon"
            android:duplicateParentState="true">

            <ImageView
                android:layout_gravity="center"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/het_nav_item_text" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/primary_nav_home"
            android:textColor="@color/het_nav_item_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_tasks"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_primary_navigation_item"
        android:clickable="true"
        android:contentDescription="@string/primary_nav_tasks"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:id="@+id/nav_tasks_icon"
            android:layout_width="54dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_primary_navigation_icon"
            android:duplicateParentState="true">

            <ImageView
                android:layout_gravity="center"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_tasks"
                android:tint="@color/het_nav_item_text" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/primary_nav_tasks"
            android:textColor="@color/het_nav_item_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_management"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_primary_navigation_item"
        android:clickable="true"
        android:contentDescription="@string/primary_nav_management"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:id="@+id/nav_management_icon"
            android:layout_width="54dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_primary_navigation_icon"
            android:duplicateParentState="true">

            <ImageView
                android:layout_gravity="center"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_management"
                android:tint="@color/het_nav_item_text" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/primary_nav_management"
            android:textColor="@color/het_nav_item_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_primary_navigation_item"
        android:clickable="true"
        android:contentDescription="@string/primary_nav_settings"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minHeight="60dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="3dp"
        android:paddingEnd="4dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:id="@+id/nav_settings_icon"
            android:layout_width="54dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_primary_navigation_icon"
            android:duplicateParentState="true">

            <ImageView
                android:layout_gravity="center"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_nav_settings"
                android:tint="@color/het_nav_item_text" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/primary_nav_settings"
            android:textColor="@color/het_nav_item_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
