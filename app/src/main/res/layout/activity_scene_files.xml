<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_scene_files"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/het_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_scene_files"
        style="@style/Widget.HET.StaticManagement.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="56dp"
        app:navigationContentDescription="@string/back_action"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/scene_sync_title" />

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_scene_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tv_scene_sync_scope"
                style="@style/TextAppearance.HET.StaticManagement.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scene_sync_scope_loading" />

            <TextView
                style="@style/TextAppearance.HET.StaticManagement.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/scene_sync_scope_description" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_scene_sync_policy"
                style="@style/Widget.HET.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.HET.StaticManagement.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scene_sync_policy_title" />

                    <TextView
                        android:id="@+id/tv_scene_sync_policy_current"
                        style="@style/TextAppearance.HET.StaticManagement.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/scene_sync_policy_preview" />

                    <TextView
                        android:id="@+id/tv_scene_sync_policy_note"
                        style="@style/TextAppearance.HET.StaticManagement.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/scene_sync_policy_note" />

                    <RadioGroup
                        android:id="@+id/group_scene_sync_policy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_scene_sync_policy_manual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_scene_sync_policy_option"
                            android:button="@null"
                            android:gravity="center_vertical|start"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/scene_sync_policy_manual_option" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_scene_sync_policy_game"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_scene_sync_policy_option"
                            android:button="@null"
                            android:gravity="center_vertical|start"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/scene_sync_policy_game_option" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_scene_sync_policy_het"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_scene_sync_policy_option"
                            android:button="@null"
                            android:gravity="center_vertical|start"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/scene_sync_policy_het_option" />
                    </RadioGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scene_sync_policy_settings"
                        style="@style/Widget.HET.StaticManagement.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="6dp"
                        android:text="@string/scene_sync_policy_settings" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_scene_sync_conflicts"
                style="@style/Widget.HET.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_scene_sync_conflicts"
                        style="@style/Widget.HET.SectionHeader"
                        android:contentDescription="@string/scene_sync_conflicts_collapse">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.HET.StaticManagement.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/scene_sync_conflicts_title" />

                            <TextView
                                android:id="@+id/tv_scene_sync_conflicts_summary"
                                style="@style/TextAppearance.HET.StaticManagement.Meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/scene_sync_conflicts_none" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_scene_sync_conflicts_arrow"
                            style="@style/Widget.HET.SectionArrow"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="⌃" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/container_scene_sync_conflicts"
                        style="@style/Widget.HET.SectionBody"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/tv_scene_sync_conflicts_empty"
                            style="@style/TextAppearance.HET.StaticManagement.Meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/scene_sync_conflicts_empty" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_scene_sync_results"
                style="@style/Widget.HET.SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.HET.StaticManagement.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scene_sync_recent_title" />

                    <TextView
                        android:id="@+id/tv_scene_sync_result"
                        style="@style/TextAppearance.HET.StaticManagement.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/scene_sync_result_ready" />

                    <LinearLayout
                        android:id="@+id/container_scene_sync_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <LinearLayout
        android:id="@+id/page_actions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/het_bottom_bar_height"
        android:background="@drawable/bg_primary_navigation"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_scene_sync"
            style="@style/Widget.HET.StaticManagement.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/scene_sync_action_sync" />
    </LinearLayout>
</LinearLayout>
