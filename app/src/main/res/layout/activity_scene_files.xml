<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_scene_files"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/het_surface"
    android:orientation="vertical">

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_scene_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_scene_files"
            style="@style/Widget.HET.StaticManagement.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:minHeight="56dp"
            app:navigationContentDescription="@string/back_action"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/scene_files_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scene_files_intro"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Meta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/scene_files_sync_status_title"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Title" />

            <TextView
                android:id="@+id/tv_scene_sync_runtime_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_static_management_status"
                android:padding="10dp"
                android:text="@string/scene_files_runtime_loading"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Body" />

            <TextView
                android:id="@+id/tv_scene_sync_refresh_scope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/scene_files_refresh_scope_local"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Meta" />

            <TextView
                android:id="@+id/tv_scene_sync_refresh_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/scene_files_refresh_ready"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Meta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scene_conflicts"
                style="@style/Widget.HET.StaticManagement.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="5dp"
                android:text="@string/scene_conflicts_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/scene_files_last_summary_title"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Title" />

            <TextView
                android:id="@+id/tv_scene_sync_last_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_static_management_status"
                android:padding="10dp"
                android:text="@string/scene_files_last_summary_empty"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Body" />

            <TextView
                android:id="@+id/tv_scene_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_static_management_status"
                android:padding="10dp"
                android:text="@string/scene_files_loading"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/scene_management_title"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Title" />

            <LinearLayout
                android:id="@+id/container_scene_batch_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                style="@style/Widget.HET.FieldLabel"
                android:layout_marginTop="8dp"
                android:text="@string/scene_file_label" />

            <Spinner
                android:id="@+id/spinner_scene_file"
                style="@style/Widget.HET.StaticManagement.Spinner"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <TextView
                style="@style/Widget.HET.FieldLabel"
                android:layout_marginTop="8dp"
                android:text="@string/scene_language_label" />

            <Spinner
                android:id="@+id/spinner_scene_language"
                style="@style/Widget.HET.StaticManagement.Spinner"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_scene_detail"
                style="@style/Widget.HET.StaticManagement.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/scene_detail_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_scene_language"
                style="@style/Widget.HET.StaticManagement.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="5dp"
                android:text="@string/pending_process_move" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/pending_process_scene_language_hint"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Meta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_scene_file"
                style="@style/Widget.HET.StaticManagement.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:text="@string/pending_process_move" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/pending_process_scene_hint"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Meta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/import_scene_files_hint"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Meta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/export_scene_files_hint"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Meta" />

            <TextView
                android:id="@+id/tv_scene_last_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textAppearance="@style/TextAppearance.HET.StaticManagement.Meta" />
        </LinearLayout>
        </LinearLayout>
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <HorizontalScrollView
        android:id="@+id/page_actions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/het_bottom_bar_height"
        android:background="@drawable/bg_primary_navigation"
        android:gravity="end|center_vertical"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh_scene_sync"
                style="@style/Widget.HET.StaticManagement.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/scene_files_refresh" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_scenes"
                style="@style/Widget.HET.StaticManagement.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="6dp"
                android:text="@string/import_scene_files" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export_scenes"
                style="@style/Widget.HET.StaticManagement.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="6dp"
                android:text="@string/export_scene_files" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
