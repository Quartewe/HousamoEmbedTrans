<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_settings_category"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_settings_category"
        style="@style/Widget.HET.SettingsRebuild.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@drawable/bg_settings_toolbar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/het_on_surface" />

    <com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView
        style="@style/Widget.HET.ScrollView"
        android:id="@+id/scroll_settings_category"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="15dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tv_settings_category_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_category_eyebrow"
                android:textColor="@color/het_primary_strong"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tv_settings_category_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/het_on_surface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_settings_category_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/het_on_surface_muted"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.5"
                android:includeFontPadding="false" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HET.SettingsCategory.ScopeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_category_scope_title"
                        android:textColor="@color/het_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tv_settings_category_scope"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/het_on_primary_container"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.45"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/settings_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/settings_additional_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_category_memory_hint"
                android:textColor="@color/het_on_surface_muted"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.45"
                android:includeFontPadding="false" />
        </LinearLayout>
    </com.quarty.housamoembedtrans.ui.DraggableScrollbarNestedScrollView>

    <LinearLayout
        android:id="@+id/settings_category_page_actions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/het_bottom_bar_height"
        android:background="@drawable/bg_primary_navigation"
        android:gravity="center_vertical|end"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_settings_category"
            style="@style/Widget.HET.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:textSize="13sp"
            android:text="@string/settings_category_save" />
    </LinearLayout>
</LinearLayout>
