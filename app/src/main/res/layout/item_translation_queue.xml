<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_translation_queue_item"
    style="@style/Widget.HET.StaticTask.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:checkable="true"
    app:checkedIcon="@null"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_translation_queue_number"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_queue_number"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.HET.StaticTask.Status"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_translation_queue_scene"
                style="@style/TextAppearance.HET.StaticTask.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tv_translation_queue_language"
                style="@style/TextAppearance.HET.StaticTask.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_translation_queue_created_at"
                style="@style/TextAppearance.HET.StaticTask.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
