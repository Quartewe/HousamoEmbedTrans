<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/het_primary_container" />
            <stroke
                android:width="1dp"
                android:color="@color/het_primary_strong" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/het_surface_container" />
            <stroke
                android:width="1dp"
                android:color="@color/het_outline_soft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
