<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.HET.SettingsRebuild.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:layout_height">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_settings_toolbar</item>
        <item name="android:elevation">0dp</item>
        <item name="contentInsetStart">4dp</item>
        <item name="contentInsetStartWithNavigation">4dp</item>
        <item name="contentInsetEnd">12dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.HET.SettingsRebuild.ToolbarTitle</item>
        <item name="titleTextColor">@color/het_on_surface</item>
    </style>

    <!-- Page-local controls mirror the prototype's compact outlined fields
         without changing the shared Material 2 theme used by other screens. -->
    <style name="Widget.HET.SettingsRebuild.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/het_surface_container</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxStrokeColor">@color/het_settings_rebuild_text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="expandedHintEnabled">false</item>
        <item name="hintEnabled">true</item>
        <item name="hintTextColor">@color/het_on_surface</item>
    </style>

    <style name="Widget.HET.SettingsRebuild.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@null</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">@color/het_on_surface</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.HET.SettingsRebuild.Helper" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:textColor">@color/het_on_surface_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.HET.SettingsRebuild.FloatingHint" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/het_on_surface</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HET.SettingsRebuild.Placeholder" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/het_on_surface_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.HET.SettingsRebuild.QueryButton" parent="Widget.HET.Button.Tonal">
        <item name="android:minHeight">28dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="TextAppearance.HET.SettingsRebuild.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/het_on_surface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
