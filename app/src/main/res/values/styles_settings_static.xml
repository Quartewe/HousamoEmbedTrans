<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Page-local roles keep the confirmed Material 2 palette out of the
         shared widget styles used by the rest of the application. -->
    <style name="Widget.HET.SettingsCategory.ScopeCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/het_primary_container</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/het_settings_scope_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.HET.Prompt.Tab" parent="Widget.HET.Button">
        <item name="android:minHeight">31dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/het_prompt_tab_text</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/het_prompt_tab_background</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.HET.Prompt.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">84dp</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/het_surface_container</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxStrokeColor">@color/het_settings_rebuild_text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="expandedHintEnabled">false</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.HET.Prompt.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:background">@null</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/het_on_surface</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.HET.Prompt.ReadonlyCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>
